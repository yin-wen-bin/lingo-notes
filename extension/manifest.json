{
  "manifest_version": 3,
  "name": "Lingo Notes",
  "version": "1.0.1",
  "description": "随手记，然后让AI帮你整理和复习",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://brbymnycnxtfchffanvs.supabase.co/*"],
  "background": {"service_worker":"background.js","type":"module"},
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "打开 Lingo Notes",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {"default_path":"panel.html"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; font-src 'self'; connect-src https://brbymnycnxtfchffanvs.supabase.co; img-src 'self' data: blob: https://brbymnycnxtfchffanvs.supabase.co"}
}
