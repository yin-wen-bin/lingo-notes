{
  "name": "lingo-notes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "test": "node scripts/test-cloud.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev:pwa": "vite --config pwa/vite.config.ts",
    "preview:pwa": "vite preview --config pwa/vite.config.ts",
    "cloud:login": "supabase login --no-browser --agent no --output-format text",
    "cloud:probe": "node scripts/cloud-provider-probe.mjs",
    "cloud:deploy": "node scripts/cloud-deploy.mjs",
    "cloud:backup": "node scripts/cloud-backup.mjs",
    "cloud:restore": "node scripts/cloud-restore.mjs",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "supabase": "^3.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  },
  "license": "MIT"
}
