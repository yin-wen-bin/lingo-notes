# Hosted Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Neither a service key nor a user's DeepSeek Key belongs in the frontend.
# DeepSeek Keys are stored per Auth user by lingo_key_set(), in Vault.
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_BUILT_EXTENSION_ID
PWA_URL=https://REPLACE_WITH_PWA_HOST/
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:REPLACE_WITH_OPERATOR_EMAIL
